{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadialFiles",
  "version": "0.1.0",
  "identifier": "com.radialfiles.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RadialFiles",
        "width": 320,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ]
  }
}
